# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
#
# The local app (app/main.py) auto-loads .env via python-dotenv (installed with
# `uv sync --extra app`). Only the variables below are actually read by code;
# anything else here would be ignored. The Vector Search endpoint and index
# names are NOT env vars — the endpoint comes from config.yaml (ai_search.endpoint,
# default cfc_ai_search) and the index/table names are derived from catalog+schema.

# --- Auth (consumed by the Databricks CLI and SDK, not by the app directly) ---
# CLI profile the app's WorkspaceClient loads. Defaults to AZURE-SA-WORKSPACE in
# code; four local profiles match this host, so naming one avoids "multiple
# profiles matched". Run `databricks auth login --profile AZURE-SA-WORKSPACE` first.
DATABRICKS_CONFIG_PROFILE=AZURE-SA-WORKSPACE
# Alternative to a profile: set host + token directly instead of the line above.
# DATABRICKS_HOST=https://adb-984752964297111.11.azuredatabricks.net
# DATABRICKS_TOKEN=

# --- App runtime (read at import by app/main.py) ---
# Each overrides a personal hardcoded default, so a dev on their own schema or
# warehouse MUST set these or the app silently queries someone else's tables.
# Unity Catalog catalog holding the po_products_ai_search* tables (code default: users).
DATABRICKS_CATALOG=users
# Schema holding the tables. Code default is a personal schema (akil_thomas);
# the dev bundle target uses your own short name — set it here.
DATABRICKS_SCHEMA=
# HTTP path of the SQL warehouse used for sampling and filter values. Find it in
# the workspace under SQL Warehouses > (your warehouse) > Connection details.
# Code default points at one specific warehouse; override it.
DATABRICKS_WAREHOUSE_HTTP_PATH=
